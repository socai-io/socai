const message = (path: string, language = defaultLanguage) =>
    messageFor(messages, path, language);
const agentInstallPrompt =
    "Read this repo and install the CLI, and add it to your skills: https://github.com/socai-io/socai .";

const pageTitle = message("meta.title");
const pageDescription = message("meta.description");
const socialImageAlt = message("meta.socialImageAlt");
---

<html lang={defaultHtmlLanguage} data-language={defaultLanguage}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta
            name="description"
            content={pageDescription}
            data-i18n-content="meta.description"
        />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="socai" />
        <meta property="og:url" content={canonicalUrl} />
        <meta
            property="og:title"
            content={pageTitle}
            data-i18n-content="meta.title"
        />
        <meta
            property="og:description"
            content={pageDescription}
            data-i18n-content="meta.description"
        />
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content={socialImageAlt}
            data-i18n-content="meta.socialImageAlt"
        />

        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content={pageTitle}
            data-i18n-content="meta.title"
        />
        <meta
            name="twitter:description"
            content={pageDescription}
            data-i18n-content="meta.description"
        />
        <meta name="twitter:image" content={socialImageUrl} />
        <meta
            name="twitter:image:alt"
            content={socialImageAlt}
            data-i18n-content="meta.socialImageAlt"
        />

        <meta name="theme-color" content="#fafaf9" />
        <meta name="application-name" content="socai" />
        <meta name="apple-mobile-web-app-title" content="socai" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
    </head>
    <body>
        <div class="site-shell">
            <SiteHeader
                messages={messages}
                language={defaultLanguage}
            />

            <main class="page-main">
                <section class="hero" aria-labelledby="hero-title">
                    <h1 id="hero-title" data-i18n="hero.title">
                        {message("hero.title")}
                    </h1>
                    <ul
                        class="hero__platforms"
                        aria-label={message("hero.platformsAria")}
                        data-i18n-aria-label="hero.platformsAria"
                    >
                        <li>
                            <img
                                src="/platforms/xiaohongshu.png"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformXiaohongshu"
                                >{message("hero.platformXiaohongshu")}</span
                            >
                        </li>
                        <li>
                            <img
                                src="/platforms/tiktok.png"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformTiktok"
                                >{message("hero.platformTiktok")}</span
                            >
                        </li>
                        <li>
                            <img
                                src="/platforms/instagram.png"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformInstagram"
                                >{message("hero.platformInstagram")}</span
                            >
                        </li>
                        <li>
                            <img
                                src="/platforms/linkedin.svg"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformLinkedin"
                                >{message("hero.platformLinkedin")}</span
                            >
                        </li>
                        <li>
                            <img
                                src="/platforms/x.png"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformX"
                                >{message("hero.platformX")}</span
                            >
                        </li>
                    </ul>
                    <p class="hero__subtitle">
                        <span
                            class="hero__subtitle-lead"
                            data-i18n="hero.subtitleLead"
                            >{message("hero.subtitleLead")}</span
                        >
                        <span
                            class="hero__subtitle-rest"
                            data-i18n="hero.subtitleRest"
                            >{message("hero.subtitleRest")}</span
                        >
                    </p>

                    <div
                        class="hero__actions"
                        role="group"
                        aria-label={message("hero.actionsAria")}
                        data-i18n-aria-label="hero.actionsAria"
                    >
                        <a
                            class="button button--primary"
                            href={webDemoUrl}
                            data-language-link
                        >
                            <span data-i18n="hero.demo"
                                >{message("hero.demo")}</span
                            >
                            <span class="button__external" aria-hidden="true"
                                >→</span
                            >
                        </a>
                        <a
                            class="button button--secondary"
                            href={bookDemoUrl}
                            data-language-link
                        >
                            <span data-i18n="hero.bookDemo"
                                >{message("hero.bookDemo")}</span
                            >
                        </a>
                    </div>
                    <div
                        class="hero__resources"
                        role="group"
                        aria-label={message("hero.resourcesAria")}
                        data-i18n-aria-label="hero.resourcesAria"
                    >
                        <a
                            class="hero__download"
                            href={downloadPath}
                            data-download-platform="macos"
                            aria-label={message("hero.download")}
                            data-i18n-aria-label="hero.download"
                            title={message("hero.download")}
                            data-i18n-title="hero.download"
                        >
                            <svg
                                data-platform-icon="macos"
                                viewBox="0 0 24 24"
                                width="22"
                                height="22"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M17.05 12.54c-.02-2.18 1.78-3.24 1.86-3.29-1.02-1.5-2.61-1.7-3.17-1.72-1.33-.14-2.62.8-3.3.8-.69 0-1.73-.78-2.85-.76-1.44.02-2.79.86-3.53 2.18-1.53 2.65-.39 6.54 1.08 8.68.74 1.06 1.6 2.24 2.72 2.2 1.1-.05 1.51-.71 2.84-.71 1.32 0 1.7.71 2.85.68 1.18-.02 1.93-1.05 2.64-2.12.86-1.21 1.2-2.41 1.22-2.47-.03-.01-2.33-.9-2.36-3.47ZM14.87 6.12c.6-.75 1.02-1.77.9-2.8-.87.04-1.97.61-2.6 1.34-.56.64-1.06 1.7-.92 2.69.99.07 2-.5 2.62-1.23Z" />
                            </svg>
                        </a>
                        <a
                            class="hero__download"
                            href={downloadWindowsPath}
                            data-download-platform="windows"
                            aria-label={message("hero.downloadWindows")}
                            data-i18n-aria-label="hero.downloadWindows"
                            title={message("hero.downloadWindows")}
                            data-i18n-title="hero.downloadWindows"
                        >
                            <svg
                                data-platform-icon="windows"
                                viewBox="0 0 24 24"
                                width="21"
                                height="21"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M3 5.35 10.44 4.3v7.14H3V5.35Zm8.27-1.17L21 2.8v8.64h-9.73V4.18ZM3 12.27h7.44v7.14L3 18.36v-6.09Zm8.27 0H21v8.65l-9.73-1.38v-7.27Z" />
                            </svg>
                        </a>
                    </div>
                    <div class="hero__install">
                        <p
                            class="hero__install-lead"
                            data-i18n="hero.agentInstall"
                        >
                            {message("hero.agentInstall")}
                        </p>
                        <div class="hero__install-row">
                            <code>{agentInstallPrompt}</code>
                            <button
                                type="button"
                                class="hero__install-copy"
                                data-copy={agentInstallPrompt}
                                aria-label={message("hero.copy")}
                                data-i18n-aria-label="hero.copy"
                            >
                                <svg
                                    class="icon-copy"
                                    viewBox="0 0 24 24"
                                    width="16"
                                    height="16"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    aria-hidden="true"
                                >
                                    <rect
                                        x="8"
                                        y="8"
                                        width="12"
                                        height="12"
                                        rx="1.5"></rect>
                                    <path
                                        d="M6 16H5.5A1.5 1.5 0 0 1 4 14.5v-9A1.5 1.5 0 0 1 5.5 4h9A1.5 1.5 0 0 1 16 5.5V6"
                                    ></path>
                                </svg>
                                <svg
                                    class="icon-check"
                                    viewBox="0 0 24 24"
                                    width="16"
                                    height="16"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12.5 9.5 17 19 7"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </section>

                <XhsShowcase />
                {(['en', 'zh'] as const).map(language => <>
                    <CreatorShowcase language={language} />
                    <TiktokShowcase language={language} />
                    <XShowcase language={language} />
                </>)}

                <section
                    class="project-feature"
                    aria-label={message("project.sectionAria")}
                    data-i18n-aria-label="project.sectionAria"
                >
                    <h2 class="built-with-heading" data-i18n="project.builtWith">
                        {message("project.builtWith")}
                    </h2>
                    <div class="project-feature__panel">
                        <div class="project-feature__copy">
                            <span
                                class="project-feature__eyebrow"
                                data-i18n="project.eyebrow"
                                >{message("project.eyebrow")}</span
                            >
                            <h2 data-i18n="project.title">
                                {message("project.title")}
                            </h2>
                            <p data-i18n="project.description">
                                {message("project.description")}
                            </p>
                            <div class="project-feature__actions">
                                <a
                                    class="button button--primary"
                                    href="https://socai-io.github.io/jev-social/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    data-i18n="project.try"
                                    >{message("project.try")}</a
                                >
                                <a
                                    class="button button--secondary"
                                    href="https://socai-io.github.io/jev-social/recorded-run/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    data-i18n="project.replay"
                                    >{message("project.replay")}</a
                                >
                                <a
                                    class="button button--secondary"
                                    href="https://github.com/socai-io/jev-social"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    data-i18n="project.source"
                                    >{message("project.source")}</a
                                >
                            </div>
                        </div>
                        <div class="project-feature__quickstart">
                            <span
                                class="project-feature__label"
                                data-i18n="project.quickstart"
                                >{message("project.quickstart")}</span
                            >
                            <pre><code><span>npx github:socai-io/jev-social#v0.1.13 onboard</span>
<span>npx github:socai-io/jev-social#v0.1.13</span></code></pre>
                        </div>
                    </div>
                </section>
            </main>

            <SiteFooter
                messages={messages}
                language={defaultLanguage}
                currentYear={currentYear}
            />
        </div>

        <script
            id="site-i18n"
            type="application/json"
            set:html={JSON.stringify(messages)}
        />
        <script>
            import "../scripts/site.ts";
        </script>
    </body>
</html>
