---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CreatorShowcase from "../components/CreatorShowcase.astro";
import TiktokShowcase from "../components/TiktokShowcase.astro";
import XShowcase from "../components/XShowcase.astro";
import XhsShowcase from "../components/XhsShowcase.astro";
import { message as messageFor } from "../lib/i18n";

const githubUrl = "/github";
const downloadPath = "/download";
const downloadWindowsPath = "/download/windows";
const webDemoUrl = "https://agent.socai.io";
const bookDemoUrl = "https://agent.socai.io/book-demo";
const currentYear = new Date().getFullYear();
const siteUrl = "https://socai.io";
const canonicalUrl = `${siteUrl}/`;
const socialImageUrl = `${siteUrl}/social-card.png?v=2`;
const defaultLanguage = "en";
const defaultHtmlLanguage =
    defaultLanguage === "zh" ? "zh-CN" : defaultLanguage;
const messages = {
    en: {
        meta: {
            title: "socai · social media research Agent",
            description:
                "Local social media research in your signed in Chrome across Xiaohongshu Douyin TikTok Instagram and LinkedIn with evidence linked to original posts",
            socialImageAlt: "socai social media research Agent preview",
        },
        nav: {
            primaryAria: "primary navigation",
            homeAria: "socai home",
            linksAria: "site links",
            github: "github",
            connect: "connect chrome",
            contact: "contact",
            languageAria: "language",
            releaseLabel: "release version {version}",
        },
        hero: {
            title: "Makes your agent actually understand social platforms.",
            subtitleLead:
                "Social media platforms are hard to access for agents. Scrapers get you banned.",
            subtitleRest:
                "Socai, instead, deeply reconstructs the structures of popular social platforms so that your agent can directly operate them in your browser.",
            platformsAria: "supported platforms",
            platformXiaohongshu: "Xiaohongshu",
            platformTiktok: "TikTok / Douyin",
            platformInstagram: "Instagram",
            platformLinkedin: "LinkedIn",
            platformX: "X",
            actionsAria: "web demo and sales",
            resourcesAria: "desktop downloads and source",
            demo: "try now",
            bookDemo: "book a demo",
            agentInstall: "Or, paste installation guide to your agent",
            copy: "copy",
            download: "download for macOS",
            downloadWindows: "download for Windows",
            github: "view on github",
        },
        preview: { sectionAria: "socai app preview" },
        project: {
            sectionAria: "Jev Social open-source project",
            eyebrow: "JEV × SOCAI",
            title: "Typed decisions. Real social evidence.",
            description:
                "Jev chooses each bounded research operation. The local socai CLI runs it in your signed-in Chrome; captured cards stay visible while a source-linked report streams in.",
            try: "try Jev Social",
            replay: "watch the recorded run",
            source: "view source",
            quickstart: "DIRECT QUICKSTART",
        },
        footer: {
            linksAria: "footer links",
            blog: "blog",
            connect: "connect guide",
            contact: "contact",
        },
    },
    zh: {
        meta: {
            title: "socai · 社交媒体调研 Agent",
            description:
                "socai 运行在你已登录的 Chrome 中 访问小红书 抖音 TikTok Instagram LinkedIn 的真实页面并返回可追溯到原始帖子的证据",
            socialImageAlt: "socai 社交媒体调研 Agent 界面预览",
        },
        nav: {
            primaryAria: "主导航",
            homeAria: "socai 首页",
            linksAria: "站点链接",
            github: "github",
            connect: "连接 Chrome",
            contact: "联系",
            languageAria: "语言",
            releaseLabel: "发布版本 {version}",
        },
        hero: {
            title: "让你的 Agent 真正理解社交平台。",
            subtitleLead: "社交平台对 Agent 很难进入。爬虫容易被封。",
            subtitleRest:
                "Socai 则会深入重建主流社交平台的结构，让你的 Agent 能直接在浏览器里操作它们。",
            platformsAria: "支持的平台",
            platformXiaohongshu: "小红书",
            platformTiktok: "抖音 / TikTok",
            platformInstagram: "Instagram",
            platformLinkedin: "LinkedIn",
            platformX: "X",
            actionsAria: "Web Demo 和预约演示",
            resourcesAria: "桌面端下载和源码",
            demo: "立即体验",
            bookDemo: "预约演示",
            agentInstall: "或者，把安装说明贴给你的 Agent",
            copy: "复制",
            download: "下载 macOS 版",
            downloadWindows: "下载 Windows 版",
            github: "在 github 查看",
        },
        preview: { sectionAria: "socai app 预览" },
        project: {
            sectionAria: "Jev Social 开源项目",
            eyebrow: "JEV × SOCAI",
            title: "类型化决策，真实社媒证据。",
            description:
                "Jev 负责选择每一步有边界的调研操作，本地 socai CLI 在你已登录的 Chrome 里执行；已抓取的卡片持续可见，带来源的报告流式生成。",
            try: "试用 Jev Social",
            replay: "观看录制回放",
            source: "查看源码",
            quickstart: "快速开始",
        },
        footer: {
            linksAria: "页脚链接",
            blog: "博客",
            connect: "连接教程",
            contact: "联系",
        },
    },
};

const message = (path: string, language = defaultLanguage) =>
    messageFor(messages, path, language);
const agentInstallPrompt =
    "Read this repo and install the CLI, and add it to your skills: https://github.com/socai-io/socai .";

const pageTitle = message("meta.title");
const pageDescription = message("meta.description");
const socialImageAlt = message("meta.socialImageAlt");
---

<html lang={defaultHtmlLanguage} data-language={defaultLanguage}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta
            name="description"
            content={pageDescription}
            data-i18n-content="meta.description"
        />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="socai" />
        <meta property="og:url" content={canonicalUrl} />
        <meta
            property="og:title"
            content={pageTitle}
            data-i18n-content="meta.title"
        />
        <meta
            property="og:description"
            content={pageDescription}
            data-i18n-content="meta.description"
        />
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content={socialImageAlt}
            data-i18n-content="meta.socialImageAlt"
        />

        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content={pageTitle}
            data-i18n-content="meta.title"
        />
        <meta
            name="twitter:description"
            content={pageDescription}
            data-i18n-content="meta.description"
        />
        <meta name="twitter:image" content={socialImageUrl} />
        <meta
            name="twitter:image:alt"
            content={socialImageAlt}
            data-i18n-content="meta.socialImageAlt"
        />

        <meta name="theme-color" content="#fafaf9" />
        <meta name="application-name" content="socai" />
        <meta name="apple-mobile-web-app-title" content="socai" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
    </head>
    <body>
        <div class="site-shell">
            <SiteHeader
                messages={messages}
                language={defaultLanguage}
            />

            <main class="page-main">
                <section class="hero" aria-labelledby="hero-title">
                    <h1 id="hero-title" data-i18n="hero.title">
                        {message("hero.title")}
                    </h1>
                    <ul
                        class="hero__platforms"
                        aria-label={message("hero.platformsAria")}
                        data-i18n-aria-label="hero.platformsAria"
                    >
                        <li>
                            <img
                                src="/platforms/xiaohongshu.png"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformXiaohongshu"
                                >{message("hero.platformXiaohongshu")}</span
                            >
                        </li>
                        <li>
                            <img
                                src="/platforms/tiktok.png"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformTiktok"
                                >{message("hero.platformTiktok")}</span
                            >
                        </li>
                        <li>
                            <img
                                src="/platforms/instagram.png"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformInstagram"
                                >{message("hero.platformInstagram")}</span
                            >
                        </li>
                        <li>
                            <img
                                src="/platforms/linkedin.svg"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformLinkedin"
                                >{message("hero.platformLinkedin")}</span
                            >
                        </li>
                        <li>
                            <img
                                src="/platforms/x.png"
                                width="24"
                                height="24"
                                alt=""
                            />
                            <span data-i18n="hero.platformX"
                                >{message("hero.platformX")}</span
                            >
                        </li>
                    </ul>
                    <p class="hero__subtitle">
                        <span
                            class="hero__subtitle-lead"
                            data-i18n="hero.subtitleLead"
                            >{message("hero.subtitleLead")}</span
                        >
                        <span
                            class="hero__subtitle-rest"
                            data-i18n="hero.subtitleRest"
                            >{message("hero.subtitleRest")}</span
                        >
                    </p>

                    <div
                        class="hero__actions"
                        role="group"
                        aria-label={message("hero.actionsAria")}
                        data-i18n-aria-label="hero.actionsAria"
                    >
                        <a
                            class="button button--primary"
                            href={webDemoUrl}
                        >
                            <span data-i18n="hero.demo"
                                >{message("hero.demo")}</span
                            >
                            <span class="button__external" aria-hidden="true"
                                >→</span
                            >
                        </a>
                        <a
                            class="button button--secondary"
                            href={bookDemoUrl}
                        >
                            <span data-i18n="hero.bookDemo"
                                >{message("hero.bookDemo")}</span
                            >
                        </a>
                    </div>
                    <div
                        class="hero__resources"
                        role="group"
                        aria-label={message("hero.resourcesAria")}
                        data-i18n-aria-label="hero.resourcesAria"
                    >
                        <a
                            class="button button--secondary"
                            href={downloadPath}
                            data-download-platform="macos"
                        >
                            <span data-i18n="hero.download"
                                >{message("hero.download")}</span
                            >
                            <span class="button__glyph" aria-hidden="true"
                                >↓</span
                            >
                        </a>
                        <a
                            class="button button--secondary"
                            href={downloadWindowsPath}
                            data-download-platform="windows"
                        >
                            <span data-i18n="hero.downloadWindows"
                                >{message("hero.downloadWindows")}</span
                            >
                            <span class="button__glyph" aria-hidden="true"
                                >↓</span
                            >
                        </a>
                        <a class="button button--secondary" href={githubUrl}>
                            <svg
                                viewBox="0 0 16 16"
                                width="16"
                                height="16"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                                ></path>
                            </svg>
                            <span data-i18n="hero.github"
                                >{message("hero.github")}</span
                            >
                            <span class="button__external" aria-hidden="true"
                                >↗</span
                            >
                        </a>
                    </div>
                    <div class="hero__install">
                        <p
                            class="hero__install-lead"
                            data-i18n="hero.agentInstall"
                        >
                            {message("hero.agentInstall")}
                        </p>
                        <div class="hero__install-row">
                            <code>{agentInstallPrompt}</code>
                            <button
                                type="button"
                                class="hero__install-copy"
                                data-copy={agentInstallPrompt}
                                aria-label={message("hero.copy")}
                                data-i18n-aria-label="hero.copy"
                            >
                                <svg
                                    class="icon-copy"
                                    viewBox="0 0 24 24"
                                    width="16"
                                    height="16"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    aria-hidden="true"
                                >
                                    <rect
                                        x="8"
                                        y="8"
                                        width="12"
                                        height="12"
                                        rx="1.5"></rect>
                                    <path
                                        d="M6 16H5.5A1.5 1.5 0 0 1 4 14.5v-9A1.5 1.5 0 0 1 5.5 4h9A1.5 1.5 0 0 1 16 5.5V6"
                                    ></path>
                                </svg>
                                <svg
                                    class="icon-check"
                                    viewBox="0 0 24 24"
                                    width="16"
                                    height="16"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12.5 9.5 17 19 7"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </section>

                <XhsShowcase />
                {(['en', 'zh'] as const).map(language => <>
                    <CreatorShowcase language={language} />
                    <TiktokShowcase language={language} />
                    <XShowcase language={language} />
                </>)}

                <section
                    class="project-feature"
                    aria-label={message("project.sectionAria")}
                    data-i18n-aria-label="project.sectionAria"
                >
                    <h2 class="built-with-heading">Built with Socai</h2>
                    <div class="project-feature__panel">
                        <div class="project-feature__copy">
                            <span
                                class="project-feature__eyebrow"
                                data-i18n="project.eyebrow"
                                >{message("project.eyebrow")}</span
                            >
                            <h2 data-i18n="project.title">
                                {message("project.title")}
                            </h2>
                            <p data-i18n="project.description">
                                {message("project.description")}
                            </p>
                            <div class="project-feature__actions">
                                <a
                                    class="button button--primary"
                                    href="https://socai-io.github.io/jev-social/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    data-i18n="project.try"
                                    >{message("project.try")}</a
                                >
                                <a
                                    class="button button--secondary"
                                    href="https://socai-io.github.io/jev-social/recorded-run/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    data-i18n="project.replay"
                                    >{message("project.replay")}</a
                                >
                                <a
                                    class="button button--secondary"
                                    href="https://github.com/socai-io/jev-social"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    data-i18n="project.source"
                                    >{message("project.source")}</a
                                >
                            </div>
                        </div>
                        <div class="project-feature__quickstart">
                            <span
                                class="project-feature__label"
                                data-i18n="project.quickstart"
                                >{message("project.quickstart")}</span
                            >
                            <pre><code><span>npx github:socai-io/jev-social#v0.1.13 onboard</span>
<span>npx github:socai-io/jev-social#v0.1.13</span></code></pre>
                        </div>
                    </div>
                </section>
            </main>

            <SiteFooter
                messages={messages}
                language={defaultLanguage}
                currentYear={currentYear}
            />
        </div>

        <script
            id="site-i18n"
            type="application/json"
            set:html={JSON.stringify(messages)}
        />
        <script>
            import "../scripts/site.ts";
        </script>
    </body>
</html>
