{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "socai",
  "version": "0.4.13",
  "identifier": "com.socai.app",
  "build": {
    "beforeDevCommand": "pnpm run prepare:lark-cli && pnpm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm run prepare:lark-cli && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "socai",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "theme": "Light",
        "width": 1180,
        "height": 860,
        "minWidth": 980,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.socai/runs/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/lark-cli"
    ],
    "resources": [
      "third-party/lark-cli-LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQ0JFNTY3QTZFRjUzMUQKUldRZFUrK21aK1hMazFSSExtMTl4QWpCZzZ5OVFjcXpicGkrTWJ6VGZlYVplYjJiZEdrajVmdE0K",
      "endpoints": [
        "https://github.com/socai-io/socai/releases/latest/download/latest.json"
      ]
    }
  }
}
