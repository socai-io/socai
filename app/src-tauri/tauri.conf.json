{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "socai",
  "version": "0.2.1",
  "identifier": "com.socai.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "socai",
        "hiddenTitle": true,
        "width": 1180,
        "height": 860,
        "minWidth": 980,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQ0JFNTY3QTZFRjUzMUQKUldRZFUrK21aK1hMazFSSExtMTl4QWpCZzZ5OVFjcXpicGkrTWJ6VGZlYVplYjJiZEdrajVmdE0K",
      "endpoints": [
        "https://github.com/socai-io/socai/releases/latest/download/latest.json"
      ]
    }
  }
}
