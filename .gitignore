__pycache__/
*.py[cod]
*.egg-info/
.venv/
.socai/
.claude/*
!.claude/skills/
!.claude/skills/**

# WorkBuddy local agent memory (per-project notes, never commit)
# Root-scoped: only the repo-root .workbuddy/ (agent memory) is ignored.
# plugins/workbuddy/ is committed source — different path, unaffected.
/.workbuddy/

# macOS
.DS_Store
**/.DS_Store

# Tauri / frontend
app/node_modules/
app/dist/
app/src-tauri/target/
app/src-tauri/gen/

# Website
site/node_modules/
site/dist/
site/.astro/
site/.vercel/

# Local scratch (client research folders, one-off notes)
local/

# Rust workspace
target/

# Packaged marketplace uploads (regenerate with plugins/workbuddy/build.sh)
plugins/workbuddy/dist/

# Skill deliverables written into whatever workspace the skill runs in
socai-reports/

# Parity scratch runs (commit fixtures intentionally, not ad-hoc smoke runs)
parity/phase1_smoke/
parity/extract_note/
parity/_screenshots/
